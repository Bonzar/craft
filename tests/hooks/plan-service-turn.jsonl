# Метку «ход служебный» ставит и снимает plan-gate-reset по словарю якорей — поэтому
# подготовка кейсов зовёт именно его, а наблюдаемое даёт сам гейт.
{"name":"показ после служебного сообщения — deny","hook":"guard-plan-service-turn","expect":"deny","setup":["plan-gate-reset"],"setup_input":{"prompt":"<task-notification>подагент отработал</task-notification>"},"input":{"tool_name":"ExitPlanMode","tool_input":{}}}
{"name":"показ после реплики Влада — allow","hook":"guard-plan-service-turn","expect":"allow","setup":["plan-gate-reset"],"setup_input":{"prompt":"покажи план"},"input":{"tool_name":"ExitPlanMode","tool_input":{}}}
{"name":"метку ставит только якорь из словаря","hook":"guard-plan-service-turn","expect":"allow","setup":["plan-gate-reset"],"setup_input":{"prompt":"продолжение работы после перерыва"},"input":{"tool_name":"ExitPlanMode","tool_input":{}}}
{"name":"не ExitPlanMode — гейт молчит","hook":"guard-plan-service-turn","expect":"silent","setup":["plan-gate-reset"],"setup_input":{"prompt":"<task-notification>подагент отработал</task-notification>"},"input":{"tool_name":"Write","tool_input":{"file_path":"/tmp/x.md"}}}
