# Гейт запрещает ПОВТОР показа: служебный ход И тот же план. Факт показа хук
# записывает сам (хеш файла плана), метки снимает реплика Влада через plan-gate-reset.
{"name": "служебный ход, план не менялся — deny", "hook": "guard-plan-service-turn", "expect": "deny", "env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-system.md"}, "setup": ["guard-plan-service-turn", "plan-gate-reset"], "setup_input": [{"tool_name": "ExitPlanMode", "tool_input": {}}, {"prompt": "<task-notification>подагент отработал</task-notification>"}], "input": {"tool_name": "ExitPlanMode", "tool_input": {}}}
{"name": "служебный ход, план изменился — allow", "hook": "guard-plan-service-turn", "expect": "allow", "env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-plain.md"}, "setup_env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-system.md"}, "setup": ["guard-plan-service-turn", "plan-gate-reset"], "setup_input": [{"tool_name": "ExitPlanMode", "tool_input": {}}, {"prompt": "<task-notification>подагент отработал</task-notification>"}], "input": {"tool_name": "ExitPlanMode", "tool_input": {}}}
{"name": "реплика Влада снимает метки — allow", "hook": "guard-plan-service-turn", "expect": "allow", "env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-system.md"}, "setup": ["guard-plan-service-turn", "plan-gate-reset", "plan-gate-reset"], "setup_input": [{"tool_name": "ExitPlanMode", "tool_input": {}}, {"prompt": "<task-notification>подагент отработал</task-notification>"}, {"prompt": "покажи план"}], "input": {"tool_name": "ExitPlanMode", "tool_input": {}}}
{"name": "первый показ в служебном ходе — allow", "hook": "guard-plan-service-turn", "expect": "allow", "env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-system.md"}, "setup": ["plan-gate-reset"], "setup_input": {"prompt": "<task-notification>подагент отработал</task-notification>"}, "input": {"tool_name": "ExitPlanMode", "tool_input": {}}}
{"name": "не ExitPlanMode — гейт молчит", "hook": "guard-plan-service-turn", "expect": "silent", "env": {"CRAFT_PLAN_FILE": "{TESTS_DIR}/fixtures/plan-system.md"}, "setup": ["plan-gate-reset"], "setup_input": {"prompt": "<task-notification>подагент отработал</task-notification>"}, "input": {"tool_name": "Write", "tool_input": {"file_path": "/tmp/x.md"}}}
