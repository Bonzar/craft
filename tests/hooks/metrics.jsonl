# Хук метрик: журнал событий сессии. Сам по себе молчит; под диспетчером видит
# решение предыдущих хуков из журнала решений в каталоге состояния. Содержимого правок,
# команд и текста отказов в журнале нет.

{"name": "метрики: хук ничего не печатает", "hook": "universal-metrics", "expect": "silent", "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m1", "tool_input": {"command": "echo hi"}}}
{"name": "метрики: вызов инструмента ложится строкой pre с именем инструмента", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"pre\",\"ts\":", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m1", "tool_input": {"command": "echo hi"}}}
{"name": "метрики: содержимое команды в журнал не идёт", "hook": "universal-metrics", "expect": "file-not-contains:echo hi", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m1", "tool_input": {"command": "echo hi"}}}
{"name": "метрики: без идентификатора сессии и переопределения журнала записи нет", "hook": "universal-metrics", "expect": "file-empty", "env": {"ASSERT_FILE": "{METRICS_DEFAULT}", "CRAFT_METRICS_LOG": "", "CLAUDE_CODE_SESSION_ID": ""}, "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "toolu_m0", "tool_input": {"command": "echo hi"}}}
{"name": "метрики: старт сессии пишет харнес и репо", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"session\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "SessionStart", "session_id": "m-sid", "cwd": "{TESTS_DIR}"}}
{"name": "метрики: реплика увеличивает номер хода", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"prompt\",\"ts\":\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "поправь"}}
{"name": "метрики: длительность вызова считается от pre до post по tool_use_id", "hook": "universal-metrics", "expect": "file-contains:\"tool_ms\":", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Read", "tool_use_id": "toolu_m2", "tool_input": {"file_path": "README.md"}}, "input": {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "Read", "tool_use_id": "toolu_m2", "tool_input": {"file_path": "README.md"}, "tool_response": {"content": "..."}}}
{"name": "метрики: ошибка инструмента в ответе помечается", "hook": "universal-metrics", "expect": "file-contains:\"error\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m3", "tool_input": {"command": "false"}, "tool_response": {"is_error": true, "content": "exit 1"}}}
{"name": "метрики: провал вызова ложится строкой fail", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"fail\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PostToolUseFailure", "session_id": "m-sid", "tool_name": "ExitPlanMode", "tool_use_id": "toolu_m4", "tool_input": {}}}
{"name": "метрики: токены хода суммируются по usage записей assistant, дубли одного message.id — один раз", "hook": "universal-metrics", "expect": "file-contains:\"usage\":{\"input\":5,\"output\":140,\"cache_read\":2200,\"cache_create\":50,\"messages\":2}", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid", "transcript_path": "{TESTS_DIR}/fixtures/transcript-usage.jsonl"}}
{"name": "метрики: второй Stop не считает уже посчитанные записи транскрипта", "hook": "universal-metrics", "expect": "file-contains:\"usage\":{\"input\":0,\"output\":0,\"cache_read\":0,\"cache_create\":0,\"messages\":0}", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "input": {"hook_event_name": "Stop", "session_id": "m-sid", "transcript_path": "{TESTS_DIR}/fixtures/transcript-usage.jsonl"}}
{"name": "метрики: под диспетчером отказ гварда виден с именем хука и классом", "hook": "dispatch", "expect": "file-contains:\"decision\":\"deny\",\"by\":\"universal-sleep-waiter-guard\",\"class\":\"sleep-waiter-guard\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m5", "tool_input": {"command": "sleep 30"}}}
{"name": "метрики: под диспетчером отказ план-гейта классифицируется, текст отказа в журнал не идёт", "hook": "dispatch", "expect": "file-contains:\"class\":\"gate.empty\"", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["session-anchor"], "setup_input": {"hook_event_name": "PostToolUse", "tool_name": "AskUserQuestion", "tool_input": {"questions": [{"question": "Какая задача будет якорем этой сессии?", "header": "Якорь сессии", "options": [{"label": "Завести новую"}]}]}, "tool_response": {"answers": {"Какая задача будет якорем этой сессии?": "Завести новую"}}}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Write", "tool_use_id": "toolu_m6", "tool_input": {"file_path": "/home/user/craft/README.md", "content": "x"}}}
{"name": "метрики: текст отказа план-гейта в журнал не пишется", "hook": "dispatch", "expect": "file-not-contains:Заблокировано", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["session-anchor"], "setup_input": {"hook_event_name": "PostToolUse", "tool_name": "AskUserQuestion", "tool_input": {"questions": [{"question": "Какая задача будет якорем этой сессии?", "header": "Якорь сессии", "options": [{"label": "Завести новую"}]}]}, "tool_response": {"answers": {"Какая задача будет якорем этой сессии?": "Завести новую"}}}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Write", "tool_use_id": "toolu_m6", "tool_input": {"file_path": "/home/user/craft/README.md", "content": "x"}}}
{"name": "метрики: под диспетчером проход пишется как allow с временем хуков", "hook": "dispatch", "expect": "file-contains:\"decision\":\"allow\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m7", "tool_input": {"command": "ls"}}}
{"name": "регресс: метрики после отказа не съедают сам отказ — гвард печатает его по-прежнему", "hook": "dispatch", "expect": "deny", "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_m8", "tool_input": {"command": "sleep 30"}}}
{"name": "метрики: блокировка конца хода пишется по имени хука", "hook": "dispatch", "expect": "file-contains:\"blocked_by\":\"universal-stop-routine-facts\"", "env": {"ASSERT_FILE": "{METRICS}", "CRAFT_AUTONOMOUS": "1"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
{"name": "метрики: вызов модели из гейта пишется обёрткой классификатора с режимом и классом ответа", "hook": "guard-plan-gate", "expect": "file-contains:\"kind\":\"model\",\"ts\":\"", "env": {"ASSERT_FILE": "{METRICS}"}, "registry_seed": [{"title": "Работа по адаптерам", "source": "plan", "kind": "work", "state": "live", "text": "", "log": [], "tasks": [{"n": 1, "title": "правка README", "where": ["README.md"], "body": "", "state": "open"}]}], "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Edit", "tool_use_id": "toolu_m9", "tool_input": {"file_path": "/home/user/craft/README.md", "old_string": "a", "new_string": "b"}}}
{"name": "метрики: у вызова модели класс ответа — токен вердикта, не текст", "hook": "guard-plan-gate", "expect": "file-contains:\"mode\":\"cover\",\"ms\":", "env": {"ASSERT_FILE": "{METRICS}"}, "registry_seed": [{"title": "Работа по адаптерам", "source": "plan", "kind": "work", "state": "live", "text": "", "log": [], "tasks": [{"n": 1, "title": "правка README", "where": ["README.md"], "body": "", "state": "open"}]}], "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Edit", "tool_use_id": "toolu_m9", "tool_input": {"file_path": "/home/user/craft/README.md", "old_string": "a", "new_string": "b"}}}

# Сводка сессии на Stop и признаки, из которых она собирается.
{"name": "сводка: на Stop в журнал ложится строка summary", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"summary\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid", "transcript_path": "{TESTS_DIR}/fixtures/transcript-usage.jsonl"}}
{"name": "сводка: токены сессии и токены первого хода в сводке (ход настоящий, с репликой)", "hook": "universal-metrics", "expect": "file-contains:\"tokens_first_turn\":{\"input\":5,\"output\":140,\"cache_read\":2200,\"cache_create\":50}", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid", "transcript_path": "{TESTS_DIR}/fixtures/transcript-usage.jsonl"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "посчитай токены хода"}}
{"name": "сводка: копия сводки лежит рядом с журналом", "hook": "universal-metrics", "expect": "file-contains:\"turns\":", "env": {"ASSERT_FILE": "{METRICS}.summary.json"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
{"name": "сводка: пуш из Bash помечается признаком без текста команды", "hook": "universal-metrics", "expect": "file-contains:\"push\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_s1", "tool_input": {"command": "git push -u origin claude/branch"}}}
{"name": "сводка: вызов скилла пишется именем", "hook": "universal-metrics", "expect": "file-contains:\"skill\":\"code-incident\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Skill", "tool_use_id": "toolu_s2", "tool_input": {"skill": "code-incident"}}}
{"name": "сводка: срабатывание детектора инцидентов видно в строке реплики под диспетчером", "hook": "dispatch", "expect": "file-contains:\"incident\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "ты сломал мою заметку, откатись"}}
{"name": "сводка: обычная реплика детектор не поднимает", "hook": "dispatch", "expect": "file-contains:\"incident\":false", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "расскажи, как устроен детектор"}}

# Хранение сводок: в кейсах выключено (METRICS_STORE=off у раннера), здесь
# проверяется только тишина; git-логика — в tests/metrics-store-git.sh.
{"name": "хранение: при выключателе METRICS_STORE=off хук молчит (работа с git — в tests/metrics-store-git.sh)", "hook": "universal-metrics-store", "expect": "silent", "input": {"hook_event_name": "Stop", "session_id": "m-sid"}, "env": {"METRICS_STORE": "off"}}
{"name": "хранение: чужое событие — молчание", "hook": "universal-metrics-store", "expect": "silent", "env": {"METRICS_STORE": ""}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_input": {"command": "ls"}}}
{"name": "хранение: Stop без сводки на диске — молчание и без работника", "hook": "universal-metrics-store", "expect": "silent", "env": {"METRICS_STORE": "", "METRICS_STORE_INLINE": "1"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}

# Сигналы: повтор реплики и переуказание, повтор вызова и стадии, ход без прогресса.
{"name": "сигналы: та же реплика второй раз помечается повтором", "hook": "universal-metrics", "expect": "file-contains:\"repeat\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "Убери хвосты из README."}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "убери хвосты из readme"}}
{"name": "сигналы: другая реплика повтором не считается", "hook": "universal-metrics", "expect": "file-not-contains:\"repeat\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "убери хвосты"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "теперь проверь кейсы"}}
{"name": "сигналы: маркер переуказания в реплике", "hook": "universal-metrics", "expect": "file-contains:\"reinstruct\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "я же просил не трогать README"}}
{"name": "сигналы: текст реплики в журнал не идёт", "hook": "universal-metrics", "expect": "file-not-contains:не трогать README", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "я же просил не трогать README"}}
{"name": "сигналы: тот же вызов повторно в ходе помечается", "hook": "universal-metrics", "expect": "file-contains:\"repeat_call\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_r1", "tool_input": {"command": "npm test"}}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_r2", "tool_input": {"command": "npm test"}}}
{"name": "сигналы: второй показ плана в том же ходе — повтор стадии", "hook": "universal-metrics", "expect": "file-contains:\"stage_repeat\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "ExitPlanMode", "tool_use_id": "toolu_p1", "tool_input": {"plan": "a"}}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "ExitPlanMode", "tool_use_id": "toolu_p2", "tool_input": {"plan": "b"}}}
{"name": "сигналы: реплика начинает новый ход — стадия не повторяется", "hook": "universal-metrics", "expect": "file-not-contains:\"stage_repeat\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "ExitPlanMode", "tool_use_id": "toolu_p1", "tool_input": {"plan": "a"}}, {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "ок"}], "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "ExitPlanMode", "tool_use_id": "toolu_p2", "tool_input": {"plan": "b"}}}
{"name": "сигналы: ход с одними чтениями — без прогресса", "hook": "universal-metrics", "expect": "file-contains:\"no_progress\":true", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "глянь"}, {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Read", "tool_use_id": "toolu_n1", "tool_input": {"file_path": "README.md"}}, {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "Read", "tool_use_id": "toolu_n1", "tool_input": {"file_path": "README.md"}, "tool_response": {"content": "x"}}], "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
{"name": "сигналы: ход с удавшейся правкой — прогресс есть", "hook": "universal-metrics", "expect": "file-contains:\"no_progress\":false", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "поправь"}, {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Edit", "tool_use_id": "toolu_n2", "tool_input": {"file_path": "README.md", "old_string": "a", "new_string": "b"}}, {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "Edit", "tool_use_id": "toolu_n2", "tool_input": {"file_path": "README.md"}, "tool_response": {"content": "ok"}}], "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
{"name": "сигналы: ход без единого вызова — разговор, не «без прогресса»", "hook": "universal-metrics", "expect": "file-contains:\"no_progress\":false", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics"], "setup_input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "как дела"}, "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
# Двойная регистрация: пишет контур, ведущий полную цепочку.
{"name": "метрики: пользовательский контур не пишет при проектной регистрации (пара к «проектный контур пишет всегда»)", "hook": "dispatch", "expect": "file-empty", "args": ["universal"], "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "cwd": "{TESTS_DIR}/../..", "tool_name": "Bash", "tool_use_id": "toolu_d1", "tool_input": {"command": "ls"}}}
{"name": "метрики: пользовательский контур пишет в сессии чужого проекта без проектной регистрации", "hook": "dispatch", "expect": "file-contains:\"kind\":\"pre\"", "args": ["universal"], "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "cwd": "/tmp", "tool_name": "Bash", "tool_use_id": "toolu_d2", "tool_input": {"command": "ls"}}}
{"name": "метрики: проектный контур пишет всегда", "hook": "dispatch", "expect": "file-contains:\"kind\":\"pre\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "PreToolUse", "session_id": "m-sid", "cwd": "{TESTS_DIR}/../..", "tool_name": "Bash", "tool_use_id": "toolu_d3", "tool_input": {"command": "ls"}}}
{"name": "метрики: повторный SessionStart (компакт) не сбрасывает номер хода", "hook": "universal-metrics", "expect": "file-contains:\"kind\":\"prompt\",\"ts\":\"", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "SessionStart", "session_id": "m-sid", "source": "startup"}, {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "раз"}, {"hook_event_name": "SessionStart", "session_id": "m-sid", "source": "compact"}], "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "два"}}
{"name": "метрики: после компакта ход второй, а не первый", "hook": "universal-metrics", "expect": "file-contains:\"turn\":2", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "SessionStart", "session_id": "m-sid", "source": "startup"}, {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "раз"}, {"hook_event_name": "SessionStart", "session_id": "m-sid", "source": "compact"}], "input": {"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "два"}}
{"name": "метрики: причина старта пишется полем source", "hook": "universal-metrics", "expect": "file-contains:\"source\":\"compact\"", "env": {"ASSERT_FILE": "{METRICS}"}, "input": {"hook_event_name": "SessionStart", "session_id": "m-sid", "source": "compact"}}
{"name": "сигналы: удавшаяся запись через Bash — прогресс есть", "hook": "universal-metrics", "expect": "file-contains:\"no_progress\":false", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "допиши"}, {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_b1", "tool_input": {"command": "echo x >> README.md"}}, {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "Bash", "tool_use_id": "toolu_b1", "tool_input": {"command": "echo x >> README.md"}, "tool_response": {"content": ""}}], "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
{"name": "сигналы: чужой MCP-инструмент записи — прогресс есть", "hook": "universal-metrics", "expect": "file-contains:\"no_progress\":false", "env": {"ASSERT_FILE": "{METRICS}"}, "setup": ["universal-metrics", "universal-metrics", "universal-metrics"], "setup_input": [{"hook_event_name": "UserPromptSubmit", "session_id": "m-sid", "prompt": "заведи PR"}, {"hook_event_name": "PreToolUse", "session_id": "m-sid", "tool_name": "mcp__github__create_pull_request", "tool_use_id": "toolu_b2", "tool_input": {"title": "x"}}, {"hook_event_name": "PostToolUse", "session_id": "m-sid", "tool_name": "mcp__github__create_pull_request", "tool_use_id": "toolu_b2", "tool_input": {"title": "x"}, "tool_response": {"content": "ok"}}], "input": {"hook_event_name": "Stop", "session_id": "m-sid"}}
