# Диспетчер: одна регистрация на событие вместо строки на хук. Проверяется, что
# он зовёт тех же хуков, что звал харнесс, обрывает цепочку на первом решении и
# сверяет матчер с именем инструмента ЦЕЛИКОМ.

{"name":"диспетчер зовёт гвард ожидания на Bash","hook":"dispatch","expect":"deny","input":{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"sleep 300"}}}
{"name":"матчер сверяется целиком: BashOutput — не Bash","hook":"dispatch","expect":"silent","input":{"hook_event_name":"PreToolUse","tool_name":"BashOutput","tool_input":{"command":"sleep 300"}}}
{"name":"цепочка обрывается на первом решении — один ответ, не два","hook":"dispatch","expect":"deny","input":{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"git push --force origin main"}}}
{"name":"диспетчер зовёт гвард провала показа плана","hook":"dispatch","expect":"contains:одобрения НЕТ","input":{"hook_event_name":"PostToolUseFailure","tool_name":"ExitPlanMode","tool_input":{}}}
{"name":"инструмент без своих хуков — молчание","hook":"dispatch","expect":"silent","input":{"hook_event_name":"PreToolUse","tool_name":"Glob","tool_input":{"pattern":"*.ts"}}}
{"name":"незнакомое событие — молчание","hook":"dispatch","expect":"silent","input":{"hook_event_name":"Notification","tool_name":"Bash"}}
{"name":"событие без имени — молчание","hook":"dispatch","expect":"silent","input":{"tool_name":"Bash","tool_input":{"command":"sleep 300"}}}
{"name":"проектный контур зовёт краевой craft-гвард первым","hook":"dispatch","expect":"contains:только через --json","input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --markdown x"}}}
{"name": "контур universal: структурная запись в Craft доходит до план-гейта", "hook": "dispatch", "expect": "contains:Заблокировано план-гейтом", "args": ["universal"], "input": {"hook_event_name": "PreToolUse", "tool_name": "mcp__Craft__craft_write", "tool_input": {"command": "blocks add --id ABC123 --json '{\"type\":\"text\",\"markdown\":\"x\"}'"}}, "setup": ["session-anchor"], "setup_input": {"hook_event_name": "PostToolUse", "tool_name": "AskUserQuestion", "tool_input": {"questions": [{"question": "Какая задача будет якорем этой сессии?", "header": "Якорь сессии", "options": [{"label": "Завести новую"}]}]}, "tool_response": {"answers": {"Какая задача будет якорем этой сессии?": "Завести новую"}}}}
{"name":"контур universal: страж записи ловит разделитель без стиля","hook":"dispatch","expect":"contains:lineStyle","args":["universal"],"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id ABC123 --json '{\"type\":\"line\",\"markdown\":\"***\"}'"}}}
{"name":"диспетчер зовёт гвард якоря на записи в базу","hook":"dispatch","expect":"contains:якор","input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"диспетчер зовёт гвард якоря на правке файла","hook":"dispatch","expect":"contains:якор","input":{"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"/home/user/craft/README.md","old_string":"a","new_string":"b"}}}
{"name":"диспетчер зовёт гвард якоря на старте сессии","hook":"dispatch","expect":"contains:Якорь сессии","input":{"hook_event_name":"SessionStart"}}
{"name":"диспетчер зовёт гвард якоря на приёме кнопочного ответа","hook":"dispatch","expect":"file-contains:Завести новую","env":{"SESSION_ANCHOR_STATE":"{TESTS_DIR}/fixtures/tmp-anchor-dispatch.txt","ASSERT_FILE":"{TESTS_DIR}/fixtures/tmp-anchor-dispatch.txt"},"input":{"hook_event_name":"PostToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Какая задача будет якорем этой сессии?","header":"Якорь сессии","options":[{"label":"Завести новую"}]}]},"tool_response":{"answers":{"Какая задача будет якорем этой сессии?":"Завести новую"}}}}
