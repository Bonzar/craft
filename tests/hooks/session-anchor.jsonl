# Якорь сессии: у каждой сессии есть своя задача в базе, и до ответа Влада о
# том, какая это задача, содержательная работа не идёт. Гейт открывает ТАП по
# кнопке (PostToolUse на AskUserQuestion с заголовком якорного вопроса), а не
# появившийся block-ID: заведение самой задачи — тоже запись, и на наличии
# задачи гейт запирал бы сам себя.

{"name":"без якоря: запись в базу — отказ","hook":"session-anchor","expect":"deny","input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"без якоря: правка файла — отказ","hook":"session-anchor","expect":"deny","input":{"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"/home/user/craft/README.md","old_string":"a","new_string":"b"}}}
{"name":"без якоря: мутирующая команда — отказ","hook":"session-anchor","expect":"deny","input":{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"sed -i s/a/b/ /home/user/craft/README.md"}}}
{"name":"без якоря: чтение командой проходит","hook":"session-anchor","expect":"allow","input":{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"cat /home/user/craft/README.md"}}}
{"name":"без якоря: файл плана проходит","hook":"session-anchor","expect":"allow","input":{"hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/root/.claude/plans/some-plan.md","content":"x"}}}
{"name":"без якоря: времянка проходит","hook":"session-anchor","expect":"allow","input":{"hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/tmp/scratch.txt","content":"x"}}}
{"name":"якорь выбран тапом — запись проходит","hook":"session-anchor","expect":"allow","setup":["session-anchor"],"setup_input":{"hook_event_name":"PostToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Какая задача будет якорем этой сессии?","header":"Якорь сессии","options":[{"label":"Добавить зависимость сессии чата и задачи в Craft"},{"label":"Завести новую"}]}]},"tool_response":{"answers":{"Какая задача будет якорем этой сессии?":"Добавить зависимость сессии чата и задачи в Craft"}}},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"тап по чужому вопросу якорь не открывает","hook":"session-anchor","expect":"deny","setup":["session-anchor"],"setup_input":{"hook_event_name":"PostToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Какой вариант дизайна берём?","header":"Дизайн","options":[{"label":"Первый"},{"label":"Второй"}]}]},"tool_response":{"answers":{"Какой вариант дизайна берём?":"Второй"}}},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"тап кладёт выбранную задачу в файл сессии","hook":"session-anchor","expect":"file-contains:Добавить зависимость сессии чата и задачи в Craft","env":{"SESSION_ANCHOR_STATE":"{TESTS_DIR}/fixtures/tmp-session-anchor.txt","ASSERT_FILE":"{TESTS_DIR}/fixtures/tmp-session-anchor.txt"},"input":{"hook_event_name":"PostToolUse","tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"Какая задача будет якорем этой сессии?","header":"Якорь сессии","options":[{"label":"Добавить зависимость сессии чата и задачи в Craft"},{"label":"Завести новую"}]}]},"tool_response":{"answers":{"Какая задача будет якорем этой сессии?":"Добавить зависимость сессии чата и задачи в Craft"}}}}
{"name":"старт сессии — директива выбрать якорь","hook":"session-anchor","expect":"contains:якорь","input":{"hook_event_name":"SessionStart"}}
{"name":"старт сессии называет заголовок якорного вопроса","hook":"session-anchor","expect":"contains:Якорь сессии","input":{"hook_event_name":"SessionStart"}}
{"name":"автономная рутина — якоря не требует","hook":"session-anchor","expect":"allow","env":{"CRAFT_AUTONOMOUS":"1"},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"замер — якоря не требует","hook":"session-anchor","expect":"allow","env":{"CRAFT_EVAL":"1"},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"вложенный вызов подагента — якоря не требует","hook":"session-anchor","expect":"allow","env":{"CRAFT_NESTED_CALL":"1"},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"пустой идентификатор сессии — не запирает насмерть","hook":"session-anchor","expect":"allow","env":{"SESSION_ANCHOR_STATE":""},"input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"отказ называет, чего ждут от агента","hook":"session-anchor","expect":"contains:задач","input":{"hook_event_name":"PreToolUse","tool_name":"mcp__Craft__craft_write","tool_input":{"command":"blocks add --id X --json {}"}}}
{"name":"пустой идентификатор сессии — старт молчит, выбор просить незачем","hook":"session-anchor","expect":"silent","env":{"SESSION_ANCHOR_STATE":""},"input":{"hook_event_name":"SessionStart"}}
{"name": "без якоря: незнакомая утилита не доказана — отказ", "hook": "session-anchor", "expect": "deny", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "craft-sync --backlinks abc"}}}
{"name": "без якоря: читающая цепочка проходит", "hook": "session-anchor", "expect": "allow", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cat README.md | grep -c x"}}}
{"name": "без якоря: пишущее звено цепочки закрывает её", "hook": "session-anchor", "expect": "deny", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cat README.md && rm README.md"}}}
{"name": "без якоря: запись во временное проходит", "hook": "session-anchor", "expect": "allow", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "echo x > /tmp/scratch.txt"}}}
{"name": "без якоря: отвод в пустое устройство чтением быть не перестаёт", "hook": "session-anchor", "expect": "allow", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "grep -q x README.md 2>/dev/null"}}}
{"name": "отказ называет команду-виновника", "hook": "session-anchor", "expect": "contains:craft-sync", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "craft-sync --write"}}}
{"name": "отказ различает меняющую состояние команду", "hook": "session-anchor", "expect": "contains:меняет состояние", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm README.md"}}}
{"name": "отказ различает недоказуемую команду", "hook": "session-anchor", "expect": "contains:не видно", "input": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "craft-sync --backlinks abc"}}}
# Нет разбора команды — про КОМАНДУ не видно ничего, и говорить «про команду ls не
# видно, что она только читает» значило бы свалить на неё чужую причину. Отказ
# остаётся (ждать разбор бессмысленно), но непокрытое названо ИМЕНЕМ (решение 14).
{"name":"без якоря и без разбора команды: отказ называет недостающую возможность","hook":"session-anchor","expect":["deny","contains:command_tree","err-contains:unsupported: command_tree"],"env":{"COMMAND_TREE_ADAPTER":"{TMPHOME}/нет-такого-разбора"},"input":{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"ls -la"}}}
