# Generated at session start by .claude/hooks/craft-inject-router.sh;
# imported into context via @-reference in CLAUDE.md. Never commit — it's
# a per-session snapshot of a live Craft document.
.claude/craft-router-context.md

# Codex receives the same live data through a SessionStart hook. User-global
# snapshots live outside the repository; these entries cover explicit test or
# development overrides that point the bridge into the checkout.
.codex/craft-router-context.md
.codex/code-rules.md

# Same: per-session snapshot of the live "Разбор инцидента" SKILL doc, fetched by
# .claude/hooks/craft-inject-incident.sh for the incident detector. Never commit.
.claude/craft-incident-context.md

# Per-session cache of block-IDs under the pre-authorised «direct-edit» pages
# (gate-exempt-pages.txt), built by .claude/hooks/universal-cache-gate-exempt-scope.sh
# for the plan-gate scope exemption. Ephemeral snapshot of live Craft — never commit.
.claude/craft-gate-exempt-scope.txt

# Снимки, которые кейсы инжект-хуков пишут рядом с фикстурами во время прогона:
# артефакт, а не входные данные. Сами фикстуры лежат в гите обычными файлами.
tests/hooks/fixtures/tmp-*-snapshot.md
tests/hooks/fixtures/tmp-session-anchor.txt
tests/hooks/fixtures/tmp-anchor-dispatch.txt
tests/hooks/fixtures/tmp-anchor-carry.md

# Session worktrees and machine-local permission overrides — per-machine state,
# not part of the system.
.claude/worktrees/
.claude/settings.local.json

# Local secrets (CRAFT_API_BASE token, CRAFT_LINKS_STORE, …). Never commit.
.env

# macOS Finder metadata.
.DS_Store
