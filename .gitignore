# Session worktrees and machine-local permission overrides — per-machine state,
# not part of the system.
.claude/worktrees/
.claude/settings.local.json

# SessionStart-hook caches of Craft content — regenerated every session,
# Craft itself is the source of truth.
.claude/craft-gate-exempt-scope.txt
.claude/craft-incident-context.md
.claude/craft-router-context.md

# Local secrets (CRAFT_API_BASE token, CRAFT_LINKS_STORE, …). Never commit.
.env

# Полный профиль Codex, который tools/jarvis-codex создаёт для одного worktree.
.codex/

# macOS Finder metadata.
.DS_Store

# Байткод Python: след запуска, а не часть системы.
__pycache__/
*.pyc
