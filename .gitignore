# Session worktrees and machine-local permission overrides — per-machine state,
# not part of the system.
.claude/worktrees/
.claude/settings.local.json

# Local secrets (CRAFT_API_BASE token, CRAFT_LINKS_STORE, …). Never commit.
.env

# Полный профиль Codex остаётся локальным. Единственное исключение —
# проектная проба чтения hooks.json самим Cloud, без доверия и состояния.
.codex/*
!.codex/hooks.json

# macOS Finder metadata.
.DS_Store

# Байткод Python: след запуска, а не часть системы.
__pycache__/
*.pyc
