#!/usr/bin/env bash
# pre-commit: снимки живого Craft (роутер, инцидент, кэш зоны, прогретый кэш)
# в коммит не попадают. Тот же скрипт гоняет CI по дереву коммита; здесь он
# смотрит индекс. Подключается установщиком: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec node tools/no-snapshot-files.js --staged
