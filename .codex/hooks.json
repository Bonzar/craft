{
  "description": "Диагностическая проба автозагрузки хуков из Git в Codex Cloud. Не запускает модули и не меняет решения разрешений.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/craft/tests/cloud_repo_probe.py",
            "timeout": 30,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/craft/tests/cloud_repo_probe.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/craft/tests/cloud_repo_probe.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
