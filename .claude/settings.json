{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-sync-local-main.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-build-sync.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-inject-router.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-inject-incident.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-cache-gate-exempt-scope.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-env-capabilities.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-detect-incident.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-plan-gate-reset.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-plan-gate-approve.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__craft_write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-guard-markdown.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-guard-plan-gate.sh" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-guard-plan-gate.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/craft-guard-plan-hygiene.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/universal-sleep-waiter-guard.sh" }
        ]
      }
    ]
  }
}
