[Unit]
Description=Stage private %i Graph reset-read credential from existing Visual holder
Before=systemd-user-sessions.service
After=local-fs.target
ConditionPathExists=/etc/assertion-memory-visual/configured/%i/standalone-graph-token

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0022
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/bin/python3 -I -B /etc/assertion-memory-visual/graph_reset_credential.py %i

[Install]
WantedBy=multi-user.target
