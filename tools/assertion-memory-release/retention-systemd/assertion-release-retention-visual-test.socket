[Unit]
Description=Release retirement witness socket (visual-test)

[Socket]
ListenStream=/run/assertion-release-retention/visual-test.sock
Accept=yes
DirectoryMode=0755
SocketUser=root
SocketGroup=assertion-visual-test-deploy
SocketMode=0660
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
