[Unit]
Description=Release retirement witness socket (visual-prod)

[Socket]
ListenStream=/run/assertion-release-retention/visual-prod.sock
Accept=yes
DirectoryMode=0755
SocketUser=root
SocketGroup=assertion-visual-prod-deploy
SocketMode=0660
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
