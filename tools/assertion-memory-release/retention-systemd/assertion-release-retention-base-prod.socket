[Unit]
Description=Release retirement witness socket (base-prod)

[Socket]
ListenStream=/run/assertion-release-retention/base-prod.sock
Accept=yes
DirectoryMode=0755
SocketUser=root
SocketGroup=assertion-production-deploy
SocketMode=0660
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
