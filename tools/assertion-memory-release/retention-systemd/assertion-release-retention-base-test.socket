[Unit]
Description=Release retirement witness socket (base-test)

[Socket]
ListenStream=/run/assertion-release-retention/base-test.sock
Accept=yes
DirectoryMode=0755
SocketUser=root
SocketGroup=assertion-test-deploy
SocketMode=0660
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
