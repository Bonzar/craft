name: Configured Release
on:
  workflow_call:
    inputs:
      profile: {type: string, required: true}
      tag: {type: string, required: true}
    secrets:
      CONFIGURED_VISUAL_HOST_PIN: {required: true}
      CONFIGURED_VISUAL_SSH_KEY: {required: true}
      CONFIGURED_VISUAL_SIGNING_KEY: {required: true}
      CONFIGURED_VISUAL_GATEWAY_TOKEN: {required: true}
permissions: {}
jobs:
  build:
    name: Build
    if: github.repository == 'Bonzar/craft' && github.ref == 'refs/heads/main' && github.ref_protected && github.run_attempt == '1'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      actions: read
    outputs:
      tag: ${{ steps.resolve.outputs.tag }}
      revision: ${{ steps.resolve.outputs.revision }}
      release_id: ${{ steps.resolve.outputs.release_id }}
      build_run_id: ${{ steps.resolve.outputs.build_run_id }}
      artifact_id: ${{ steps.resolve.outputs.artifact_id }}
      archive_sha: ${{ steps.resolve.outputs.archive_sha }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - id: resolve
        env:
          PROFILE: ${{ inputs.profile }}
          SELECTED_TAG: ${{ inputs.tag }}
          GH_TOKEN: ${{ github.token }}
          CONTROL_REF_PROTECTED: ${{ github.ref_protected }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-release/experimental/configured_release.py
  test:
    name: TEST
    needs: [build]
    if: inputs.profile == 'visual' && vars.CONFIGURED_VISUAL_GLOBAL_ENABLE == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 13
    environment: configured-release-visual-test
    concurrency:
      group: assertion-memory-visual-test
      cancel-in-progress: false
    permissions:
      contents: read
      actions: read
    env:
      VISUAL_ENV: test
      GRAPH_TAG: ${{ needs.build.outputs.tag }}
      NATIVE_VISUAL_READY: ${{ vars.CONFIGURED_VISUAL_READY }}
    outputs:
      proof: ${{ steps.receipt.outputs.proof }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Set local directory
        run: printf 'VISUAL_DOWNLOAD=%s/configured-visual\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - id: artifact
        name: Verify exact immutable visual archive and stage approval
        env:
          GH_TOKEN: ${{ github.token }}
          NATIVE_VISUAL_ENV_ID: ${{ vars.CONFIGURED_VISUAL_ENV_ID }}
          NATIVE_VISUAL_REVIEWER_ID: ${{ vars.CONFIGURED_VISUAL_REVIEWER_ID }}
          GRAPH_REVISION: ${{ needs.build.outputs.revision }}
          GRAPH_RELEASE_ID: ${{ needs.build.outputs.release_id }}
          GRAPH_BUILD_RUN_ID: ${{ needs.build.outputs.build_run_id }}
          GRAPH_ARTIFACT_ID: ${{ needs.build.outputs.artifact_id }}
          GRAPH_ARCHIVE_SHA: ${{ needs.build.outputs.archive_sha }}
          GRAPH_VERIFIED_SHA: ${{ needs.build.outputs.archive_sha }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/configured_visual.py resolve
      - name: Activate exact visual archive
        env:
          VISUAL_REVISION: ${{ steps.artifact.outputs.revision }}
          VISUAL_SHA: ${{ steps.artifact.outputs.sha256 }}
          VISUAL_DIGEST: ${{ steps.artifact.outputs.release }}
          CONFIGURED_VISUAL_DEPLOY_ENABLED: ${{ vars.CONFIGURED_VISUAL_DEPLOY_ENABLED }}
          VISUAL_HOST: ${{ vars.CONFIGURED_VISUAL_HOST }}
          VISUAL_PORT: ${{ vars.CONFIGURED_VISUAL_PORT }}
          VISUAL_HOST_PIN: ${{ secrets.CONFIGURED_VISUAL_HOST_PIN }}
          VISUAL_SSH_KEY: ${{ secrets.CONFIGURED_VISUAL_SSH_KEY }}
          VISUAL_SIGNING_KEY: ${{ secrets.CONFIGURED_VISUAL_SIGNING_KEY }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/configured_visual.py send
      - name: Smoke exact visual ingress
        env:
          VISUAL_DIGEST: ${{ steps.artifact.outputs.release }}
          VISUAL_GATEWAY_HOST: ${{ vars.CONFIGURED_VISUAL_GATEWAY_HOST }}
          VISUAL_GATEWAY_TOKEN: ${{ secrets.CONFIGURED_VISUAL_GATEWAY_TOKEN }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/smoke.py
      - name: Record exact native visual TEST identity
        env:
          NATIVE_VISUAL_TEST_PROOF: ${{ steps.artifact.outputs.proof }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/configured_visual.py receipt
      - name: Preserve visual TEST evidence
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: configured-release-visual-test-${{ github.run_id }}-attempt-${{ github.run_attempt }}
          path: ${{ runner.temp }}/configured-visual/native-test-proof.json
          if-no-files-found: error
      - id: receipt
        name: Publish same-run visual TEST proof for PROD
        env:
          PROOF: ${{ steps.artifact.outputs.proof }}
        run: printf 'proof=%s\n' "$PROOF" >> "$GITHUB_OUTPUT"
  prod:
    name: PROD
    needs: [build, test]
    if: inputs.profile == 'visual' && vars.CONFIGURED_VISUAL_GLOBAL_ENABLE == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 13
    environment: configured-release-visual-prod
    concurrency:
      group: assertion-memory-visual-prod
      cancel-in-progress: false
    permissions:
      contents: read
      actions: read
    env:
      VISUAL_ENV: prod
      GRAPH_TAG: ${{ needs.build.outputs.tag }}
      NATIVE_VISUAL_READY: ${{ vars.CONFIGURED_VISUAL_READY }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Set local directory
        run: printf 'VISUAL_DOWNLOAD=%s/configured-visual\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - id: artifact
        name: Verify exact immutable visual archive and stage approval
        env:
          GH_TOKEN: ${{ github.token }}
          NATIVE_VISUAL_ENV_ID: ${{ vars.CONFIGURED_VISUAL_ENV_ID }}
          NATIVE_VISUAL_REVIEWER_ID: ${{ vars.CONFIGURED_VISUAL_REVIEWER_ID }}
          GRAPH_REVISION: ${{ needs.build.outputs.revision }}
          GRAPH_RELEASE_ID: ${{ needs.build.outputs.release_id }}
          GRAPH_BUILD_RUN_ID: ${{ needs.build.outputs.build_run_id }}
          GRAPH_ARTIFACT_ID: ${{ needs.build.outputs.artifact_id }}
          GRAPH_ARCHIVE_SHA: ${{ needs.build.outputs.archive_sha }}
          GRAPH_VERIFIED_SHA: ${{ needs.build.outputs.archive_sha }}
          NATIVE_VISUAL_TEST_PROOF: ${{ needs.test.outputs.proof }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/configured_visual.py resolve
      - name: Activate exact visual archive
        env:
          VISUAL_REVISION: ${{ steps.artifact.outputs.revision }}
          VISUAL_SHA: ${{ steps.artifact.outputs.sha256 }}
          VISUAL_DIGEST: ${{ steps.artifact.outputs.release }}
          CONFIGURED_VISUAL_DEPLOY_ENABLED: ${{ vars.CONFIGURED_VISUAL_DEPLOY_ENABLED }}
          VISUAL_HOST: ${{ vars.CONFIGURED_VISUAL_HOST }}
          VISUAL_PORT: ${{ vars.CONFIGURED_VISUAL_PORT }}
          VISUAL_HOST_PIN: ${{ secrets.CONFIGURED_VISUAL_HOST_PIN }}
          VISUAL_SSH_KEY: ${{ secrets.CONFIGURED_VISUAL_SSH_KEY }}
          VISUAL_SIGNING_KEY: ${{ secrets.CONFIGURED_VISUAL_SIGNING_KEY }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/configured_visual.py send
      - name: Smoke exact visual ingress
        env:
          VISUAL_DIGEST: ${{ steps.artifact.outputs.release }}
          VISUAL_GATEWAY_HOST: ${{ vars.CONFIGURED_VISUAL_GATEWAY_HOST }}
          VISUAL_GATEWAY_TOKEN: ${{ secrets.CONFIGURED_VISUAL_GATEWAY_TOKEN }}
        run: PYTHONPATH=tools/assertion-memory-release python3 -B tools/assertion-memory-visual/smoke.py
