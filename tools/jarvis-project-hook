#!/usr/bin/env python3
"""Ранняя точка входа хуков Codex Desktop из исходников worktree.

Этот файл существует в Git вместе с `.codex/config.toml`. Local Environment
сначала ставит набор в `.codex` worktree, затем Desktop запускает эту точку
входа. Она использует установленный локальный набор; состояние остаётся
в `.codex/state` worktree. Глобального фолбека нет.
"""

import argparse
import importlib.util
import os
import sys
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parents[1]
MODULES = REPOSITORY / '.codex' / 'jarvis' / 'modules'
CORE = REPOSITORY / 'core'
STATE = REPOSITORY / '.codex' / 'state'


def module_entry(slug: str) -> Path:
    """Вернуть проверенную точку входа установленного модуля."""
    if '/' in slug or '\\' in slug or slug in ('.', '..'):
        raise ValueError(f'некорректный slug модуля: {slug!r}')
    entry = MODULES / slug / 'hooks' / 'module.py'
    if not entry.is_file():
        raise ValueError(
            f'модуль «{slug}» не установлен в worktree: {entry}; '
            'выполни python3 tools/jarvis-desktop-setup'
        )
    return entry


def load_module(slug: str):
    """Загрузить установленный hook-модуль, сохранив его путь к себе."""
    entry = module_entry(slug)
    name = f'jarvis_project_hook_{slug.replace("-", "_")}'
    spec = importlib.util.spec_from_file_location(name, entry)
    if spec is None or spec.loader is None:
        raise RuntimeError(f'не удалось подготовить импорт {entry}')
    loaded = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(loaded)
    return entry, loaded


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--module', required=True, dest='slug')
    known, rest = parser.parse_known_args(argv)
    if str(CORE) not in sys.path:
        sys.path.insert(0, str(CORE))
    os.environ['JARVIS_STATE_DIR'] = str(STATE)
    # Desktop использует свой общий профиль, поэтому не читает AGENTS из
    # альтернативного CODEX_HOME. Доставляем уже отрендеренные установщиком
    # правила выводом SessionStart, а не исходники с плейсхолдерами.
    os.environ['JARVIS_RULES_FILE'] = str(REPOSITORY / '.codex' / 'AGENTS.md')
    entry, loaded = load_module(known.slug)
    return loaded.wrappers.run_hook(str(entry), loaded.Module, argv=rest)


if __name__ == '__main__':
    raise SystemExit(main())
